{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/participant-help", "destination": "/api/help" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
