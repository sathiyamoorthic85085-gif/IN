{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/participant-help",
      "destination": "/api/help"
    },
    {
      "source": "/((?!api/|media/|assets/|favicon.ico|manifest.webmanifest|sw.js|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
