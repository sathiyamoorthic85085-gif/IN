# InnoHack-26 Environment Variables for Vercel / Local

# 1. Google Sheets & Google Drive Backend (Google Form style output + Automated Gmail)
# Deploy google-apps-script.js as a Web App in Google Sheets and paste the Web App URL here:
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SHEETS_SPREADSHEET_ID=1lRU5V6jQopSxwvSZEMoFJurwFZEuMH2pgbjIACHSXP0

# 2. Automated Confirmation Email / Gmail SMTP (Optional - Google Apps Script handles it natively)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SITE_URL=https://innohack26.vercel.app

# 3. Database (Optional if using Google Sheets directly)
DATABASE_URL=mysql://user:pass@host:port/dbname
REGISTRATION_ENCRYPTION_SECRET=your-random-32-char-encryption-key
COOKIE_SECRET=your-session-cookie-secret

# 4. AI Participant Help Assistant (Optional)
MOONSHOT_API_KEY=your-moonshot-kimi-key
KIMI_MODEL=kimi-k2.6
# Or use OpenAI:
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o-mini
